# LGKA+ iOS release lanes, run by .github/workflows/release.yml.
#
#   bundle exec fastlane ios release    # archive, upload to TestFlight, push the store listing
#   bundle exec fastlane ios metadata   # store texts and screenshots only
#
# Needs ASC_KEY_ID, ASC_ISSUER_ID and ASC_KEY_P8 (App Store Connect API key); release
# also needs IOS_DIST_CERT_P12_BASE64 and IOS_DIST_CERT_PASSWORD.
# Submitting for review stays a manual step in App Store Connect.

require "base64"
require "fileutils"
require "yaml"

default_platform(:ios)

APP_ID   = "com.lgka"
TEAM_ID  = "M8M22924DJ"
# App Store profile and Apple Distribution certificate, both expire 2026-12-17.
PROFILE  = "LGKA+ Distribution"
ROOT     = File.expand_path("..", __dir__)
KEY_PATH = File.join(ROOT, "build", "AuthKey.p8")
THEME    = ENV.fetch("SCREENSHOT_THEME", "dark")
# Screenshot folders in app_store_assets → App Store Connect locales of the app.
LOCALES  = { "de" => "de-DE" }.freeze
# The only screenshots that go to the store, in this order.
STORE_SHOTS = %w[01_welcome.png 02_home.png 03_weather.png 04_news.png].freeze

platform :ios do
  before_all do
    FileUtils.mkdir_p(File.dirname(KEY_PATH))
    File.write(KEY_PATH, ENV.fetch("ASC_KEY_P8"))
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: KEY_PATH,
    )
  end

  desc "Archive with the distribution certificate, upload to TestFlight, update the store listing"
  lane :release do
    version = marketing_version
    # Continues after the Flutter app's builds (last one: 300).
    build = latest_testflight_build_number(app_identifier: APP_ID, initial_build_number: 0) + 1
    UI.message("Releasing LGKA+ #{version} (#{build})")

    install_signing
    build_app(
      project: File.join(ROOT, "LGKA.xcodeproj"),
      scheme: "LGKA",
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      export_team_id: TEAM_ID,
      export_options: { signingStyle: "manual", teamID: TEAM_ID, provisioningProfiles: { APP_ID => PROFILE } },
      output_directory: File.join(ROOT, "build", "release"),
      xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build}",
    )
    upload_to_testflight(app_identifier: APP_ID, skip_waiting_for_build_processing: true)
    metadata(version: version)
  end

  desc "Upload store texts, screenshots and review contact (no build)"
  lane :metadata do |options|
    deliver(
      app_identifier: APP_ID,
      app_version: options[:version] || marketing_version,
      # absolute: fastlane evaluates the Fastfile with __dir__ == ".", and deliver runs from the repo root
      metadata_path: File.join(ROOT, "fastlane", "metadata"),
      screenshots_path: stage_screenshots,
      app_review_information: review_information,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      # precheck cannot inspect in-app purchases with an API key and would abort the upload.
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      force: true,
    )
  end
end

# Manual signing: automatic signing on a fresh runner creates a new development
# certificate per run, and the API key may not use cloud-managed distribution signing.
def install_signing
  setup_ci(force: true) # temporary keychain, removed with the runner
  p12 = File.join(ROOT, "build", "distribution.p12")
  File.binwrite(p12, Base64.decode64(ENV.fetch("IOS_DIST_CERT_P12_BASE64")))
  import_certificate(
    certificate_path: p12,
    certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
    keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME"),
    keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD"),
  )
  FileUtils.rm_f(p12)
  get_provisioning_profile(app_identifier: APP_ID, readonly: true, output_path: File.join(ROOT, "build"))
  update_code_signing_settings(
    path: File.join(ROOT, "LGKA.xcodeproj"),
    targets: ["LGKA"],
    build_configurations: ["Release"],
    use_automatic_signing: false,
    team_id: TEAM_ID,
    code_sign_identity: "Apple Distribution",
    profile_name: PROFILE,
  )
end

# Tag v3.1.0 → "3.1.0"; otherwise the MARKETING_VERSION in project.yml.
def marketing_version
  tag = ENV["RELEASE_VERSION"].to_s.sub(/\Av/, "")
  return tag unless tag.empty?

  YAML.load_file(File.join(ROOT, "project.yml")).dig("targets", "LGKA", "settings", "base", "MARKETING_VERSION").to_s
end

# deliver reads <locale>/*.png and picks the display slot from the pixel size;
# the prefix keeps phone and tablet shots in the suite's order.
def stage_screenshots
  out = File.join(ROOT, "build", "deliver_screenshots")
  FileUtils.rm_rf(out)
  LOCALES.each do |folder, locale|
    FileUtils.mkdir_p(File.join(out, locale))
    %w[phone tablet].each do |form|
      STORE_SHOTS.each do |name|
        png = File.join(ROOT, "app_store_assets", "screenshots", folder, "ios", form, THEME, name)
        FileUtils.cp(png, File.join(out, locale, "#{form}_#{name}"))
      end
    end
  end
  out
end

# The repo is public: review contact and demo login come from secrets.
def review_information
  {
    first_name: "Luka",
    last_name: "Löhr",
    email_address: "support@lgka.app",
    phone_number: ENV.fetch("ASC_REVIEW_PHONE"),
    demo_user: ENV.fetch("ASC_REVIEW_DEMO_USER"),
    demo_password: ENV.fetch("ASC_REVIEW_DEMO_PASSWORD"),
    notes: "Die Zugangsdaten sind die allgemeinen Schülerzugangsdaten des Lessing-Gymnasiums Karlsruhe.",
  }
end
